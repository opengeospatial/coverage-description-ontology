# baseURI: http://www.opengis.net/ont/swe/
# imports: http://purl.org/dc/elements/1.1/
# imports: http://qudt.org/$$QUDT_VERSION$$/schema/qudt
# imports: http://www.opengis.net/ont/geosparql#
# imports: http://www.w3.org/2004/02/skos/core
# prefix: swe

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix geosparql: <http://www.opengis.net/ont/geosparql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix swe: <http://www.opengis.net/ont/swe/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

swe:
  a owl:Ontology ;
  dcterms:created "2026-02-24"^^xsd:date ;
  dcterms:creator <https://orcid.org/0000-0002-3884-3420> ;
  dcterms:description "Explicit OWL2 implementation of SWE Common Record Object schema" ;
  dcterms:isVersionOf <https://docs.ogc.org/is/24-014/24-014.html> ;
  dcterms:modified "2026-03-19"^^xsd:date ;
  dcterms:source "https://docs.ogc.org/is/24-014/24-014.html"^^xsd:anyURI ;
  dcterms:title "SWE Common Record Object Ontology" ;
  rdfs:comment """This ontology is an attempt to directly translate the SWE Common Record Object schema. 
  It is based on the UML model of the SWE Common Record Object schema, which is available at https://docs.ogc.org/is/24-014/24-014.html. 
  
  Class and property names (local names) match UML class and property names exactly except for the swe:valueObject ObjectProperty that complements swe:value DatatypeProperty.
  
  The ontology was created manually.""" ;
  owl:imports <http://purl.org/dc/elements/1.1/> ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> ;
  owl:imports geosparql: ;
  owl:imports <http://www.w3.org/2004/02/skos/core> ;
.
swe:AbstractDataComponent
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#uml_record_components> ;
  rdfs:label "AbstractDataComponent" ;
  rdfs:subClassOf swe:AbstractSWEIdentifiable ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:ScopedName ;
      owl:onProperty swe:definition ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:definition ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:optional ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:updatable ;
    ] ;
.
swe:AbstractEncoding
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#uml_dataarray_class> ;
  rdfs:label "AbstracEncoding" ;
.
swe:AbstractSWEIdentifiable
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#uml_alldatacomponents> ;
  rdfs:label "AbstractSWEIdentifiable" ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:description ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:id ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:label ;
    ] ;
.
swe:AbstractSimpleComponent
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#uml_simplecomponents> ;
  rdfs:label "AbstractSimpleComponent" ;
  rdfs:subClassOf swe:AbstractDataComponent ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:NilValues ;
      owl:onProperty swe:nilValues ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:Quality ;
      owl:onProperty swe:quality ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:axisID ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:constraint ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:nilValues ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:quality ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:referenceFrame ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:value ;
    ] ;
.
swe:AllowedGeometries
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#uml_geometry_class> ;
  rdfs:label "AllowedGeometries" ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:minCardinality "0"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:geomType ;
    ] ;
.
swe:AllowedTimes
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#uml_allowedtimes_class> ;
  rdfs:label "AllowedTimes" ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:TimePair ;
      owl:onProperty swe:interval ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom xsd:positiveInteger ;
      owl:onProperty swe:significantFigures ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:significantFigures ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:minCardinality "0"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:interval ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:minCardinality "0"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:valueObject ;
    ] ;
.
swe:AllowedTokens
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#uml_allowedtokens_class> ;
  rdfs:label "AllowedTokens" ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom xsd:string ;
      owl:onProperty swe:pattern ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom xsd:string ;
      owl:onProperty swe:value ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:pattern ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:minCardinality "0"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:value ;
    ] ;
.
swe:AllowedValues
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#uml_allowedvalues_class> ;
  rdfs:label "AllowedValues" ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:Real ;
      owl:onProperty swe:value ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:RealPair ;
      owl:onProperty swe:interval ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom xsd:integer ;
      owl:onProperty swe:significantFigures ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:significantFigures ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:minCardinality "0"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:interval ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:minCardinality "0"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:value ;
    ] ;
.
swe:AnyNumerical
  a owl:Class ;
  dcterms:source "https://docs.ogc.org/is/24-014/24-014.html#_b34a59af-d7b7-40a4-9e27-10c1eeb08bb1" ;
  rdfs:label "AnyNumerical" ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:Count ;
      owl:onProperty swe:byCount ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:Quantity ;
      owl:onProperty swe:byQuantity ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:Time ;
      owl:onProperty swe:byTime ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:bySomething ;
    ] ;
  skos:definition "Instances of this class should take one of byCount, byQuantity, byTime, which are sub-properties of bySomething" ;
.
swe:AnyRange
  a owl:Class ;
  dcterms:source "https://docs.ogc.org/is/24-014/24-014.html#_b34a59af-d7b7-40a4-9e27-10c1eeb08bb1" ;
  rdfs:label "AnyRange" ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:CategoryRange ;
      owl:onProperty swe:byCategoryRange ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:CountRange ;
      owl:onProperty swe:byCountRange ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:QuantityRange ;
      owl:onProperty swe:byQuantityRange ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:TimeRange ;
      owl:onProperty swe:byTimeRange ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:bySomething ;
    ] ;
  skos:definition "Instances of this class should take one of byCountRange, byQuantityRange, byTimeRange, byCategoryRange, which are sub-properties of bySomething" ;
.
swe:AnyScalar
  a owl:Class ;
  dcterms:source "https://docs.ogc.org/is/24-014/24-014.html#_b34a59af-d7b7-40a4-9e27-10c1eeb08bb1" ;
  rdfs:label "AnyScalar" ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:bySomething ;
    ] ;
  skos:definition "Instances of this class should take one of byBoolean, byCount, byQuantity, byTime, byCategory, byText, which are sub-properties of bySomething" ;
.
swe:Boolean
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#uml_boolean_class> ;
  rdfs:label "Boolean" ;
  rdfs:subClassOf swe:AbstractSimpleComponent ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom xsd:boolean ;
      owl:onProperty swe:value ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:value ;
    ] ;
.
swe:Category
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#uml_category_class> ;
  rdfs:label "Category" ;
  rdfs:subClassOf swe:AbstractSimpleComponent ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:AllowedTokens ;
      owl:onProperty swe:constraint ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom xsd:string ;
      owl:onProperty swe:value ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:codeSpace ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:constraint ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:value ;
    ] ;
.
swe:CategoryRange
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#uml_categoryrange_class> ;
  rdfs:label "CategoryRange" ;
  rdfs:subClassOf swe:AbstractSimpleComponent ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:AllowedTokens ;
      owl:onProperty swe:constraint ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:TokenPair ;
      owl:onProperty swe:valueObject ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:codeSpace ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:constraint ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:valueObject ;
    ] ;
.
swe:Count
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#uml_count_class> ;
  rdfs:label "Count" ;
  rdfs:subClassOf swe:AbstractSimpleComponent ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:AllowedValues ;
      owl:onProperty swe:constraint ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom xsd:integer ;
      owl:onProperty swe:value ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:constraint ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:value ;
    ] ;
.
swe:CountRange
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#uml_countrange_class> ;
  rdfs:label "CountRange" ;
  rdfs:subClassOf swe:AbstractSimpleComponent ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:AllowedValues ;
      owl:onProperty swe:constraint ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:IntegerPair ;
      owl:onProperty swe:valueObject ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:constraint ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:valueObject ;
    ] ;
.
swe:DataArray
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#uml_dataarray_class> ;
  rdfs:label "DataArray" ;
  rdfs:subClassOf swe:AbstractDataComponent ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:AbstractDataComponent ;
      owl:onProperty swe:elementType ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:AbstractEncoding ;
      owl:onProperty swe:encoding ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:Count ;
      owl:onProperty swe:elementCount ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:EncodedValues ;
      owl:onProperty swe:values ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:elementCount ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:elementType ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:encoding ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:values ;
    ] ;
.
swe:DataChoice
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#uml_datachoice_class> ;
  rdfs:label "DataChoice" ;
  rdfs:subClassOf swe:AbstractDataComponent ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:AbstractDataComponent ;
      owl:onProperty swe:item ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:Category ;
      owl:onProperty swe:choiceValue ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:choiceValue ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:minCardinality "2"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:item ;
    ] ;
  skos:definition "The “DataChoice” class (also called Disjoint Union) is modeled on the definition of ‘Choice’ from ISO 11404. It is a composite component that allows for a choice of child components. By opposition to records that carry all their fields simultaneously, only one item at a time can be present in the data when wrapped in a “DataChoice”." ;
.
swe:DataRecord
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#uml_datarecord_class> ;
  rdfs:label "DataRecord" ;
  rdfs:subClassOf swe:AbstractDataComponent ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:AbstractDataComponent ;
      owl:onProperty swe:field ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:field ;
    ] ;
  skos:definition "The “DataRecord” class is modeled on the definition of ‘Record’ from ISO 11404. In this definition, a record is a composite data type composed of one to many fields, each of which having its own name and type definition. Thus it defines some logical collection of components of any type that are grouped for a given purpose." ;
.
swe:DataStream
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#uml_datastream_class> ;
  rdfs:label "DataStream" ;
  rdfs:subClassOf swe:AbstractSWEIdentifiable ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:AbstractDataComponent ;
      owl:onProperty swe:elementType ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:AbstractEncoding ;
      owl:onProperty swe:encoding ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:Count ;
      owl:onProperty swe:elementCount ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:EncodedValues ;
      owl:onProperty swe:values ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:elementType ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:encoding ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:values ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:elementCount ;
    ] ;
.
swe:EncodedValues
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#uml_dataarray_class> ;
  rdfs:label "EncodedValues" ;
.
swe:GeomType
  a rdfs:Datatype ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#uml_geometry_class> ;
  rdfs:label "GeomType" ;
  owl:oneOf (
      "Point"
      "LineString"
      "Polygon"
      "MultiPoint"
      "MultiLineString"
      "MultiPolygon"
    ) ;
.
swe:Geometry
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#uml_geometry_class> ;
  rdfs:label "Geometry" ;
  rdfs:subClassOf swe:AbstractDataComponent ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom geosparql:Geometry ;
      owl:onProperty swe:valueObject ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:AllowedGeometries ;
      owl:onProperty swe:constraint ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:srs ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:constraint ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:valueObject ;
    ] ;
.
swe:IntegerPair
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#uml_basic_types> ;
  rdfs:label "IntegerPair" ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom xsd:integer ;
      owl:onProperty swe:item ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:cardinality "2"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:item ;
    ] ;
.
swe:Matrix
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#uml_matrix_class> ;
  rdfs:label "Matrix" ;
  rdfs:subClassOf swe:DataArray ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:localFrame ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:referenceFrame ;
    ] ;
.
swe:NilValue
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#uml_nilvalues_class> ;
  rdfs:label "NilValue" ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:nilReason ;
    ] ;
  rdfs:subClassOf [
