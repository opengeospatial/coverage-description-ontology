  a owl:ObjectProperty ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#uml_simple_components> ;
  rdfs:label "value (object)" ;
.
swe:values
  a owl:ObjectProperty ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#uml_dataarray_class> ;
  rdfs:domain [
      a owl:Class ;
      owl:unionOf (
          swe:DataArray
          swe:DataStream
        ) ;
    ] ;
  rdfs:label "values" ;
  rdfs:range swe:EncodedValues ;
.
