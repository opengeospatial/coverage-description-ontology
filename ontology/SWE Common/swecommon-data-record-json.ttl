  dcterms:source "https://schemas.opengis.net/sweCommon/3.0/json/encodings.json" ;
  rdfs:domain swe:TextEncoding ;
  rdfs:label "blockSeparator" ;
  rdfs:range xsd:string ;
  skos:definition "Character sequence used as the block separator (i.e., between two successive blocks in the data set. The end of a block is reached once all values from the data tree have been encoded once)" ;
.
