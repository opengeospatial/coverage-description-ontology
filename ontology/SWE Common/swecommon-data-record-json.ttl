# baseURI: http://www.opengis.net/ont/swe/
# imports: http://purl.org/dc/elements/1.1/
# imports: http://qudt.org/$$QUDT_VERSION$$/schema/qudt
# imports: http://www.opengis.net/ont/geosparql#
# imports: http://www.w3.org/2004/02/skos/core
# prefix: swe

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix geosparql: <http://www.opengis.net/ont/geosparql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix swe: <http://www.opengis.net/ont/swe/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

swe:
  a owl:Ontology ;
  dcterms:created "2026-03-19"^^xsd:date ;
  dcterms:creator <https://orcid.org/0000-0002-3884-3420> ;
  dcterms:description "Explicit OWL2 implementation of SWE Common Record Object schema" ;
  dcterms:isVersionOf <https://docs.ogc.org/is/24-014/24-014.html> ;
  dcterms:modified "2026-03-19"^^xsd:date ;
  dcterms:source "https://docs.ogc.org/is/24-014/24-014.html"^^xsd:anyURI ;
  dcterms:title "SWE Common Record Object Ontology" ;
  rdfs:comment """This ontology is an attempt to directly translate the SWE Common Record Object schema. 
  It is based on the JSON implementation of the UML model of the SWE Common Record Object schema, which is described in https://docs.ogc.org/is/24-014/24-014.html. 
  The official JSON schema is available at https://schemas.opengis.net/sweCommon/3.0/json/ .
  
  Class and property names (local names) in the Ontology are intended to match JSON terms exactly. 

For arrays, the ontology has max=* and the JSON-LD Context adds @list (ordered) or @set (unordered) as the value of the @container key. 
See https://www.w3.org/TR/json-ld11/#sets-and-lists 

  
  The motivation here is so that the JSON-LD serialization of the OWL is as close as possible to the JSON Schema version.
  The ontology was created manually.""" ;
  owl:imports <http://purl.org/dc/elements/1.1/> ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/schema/qudt> ;
  owl:imports geosparql: ;
  owl:imports <http://www.w3.org/2004/02/skos/core> ;
.
swe:AbstractArray
  a owl:Class ;
  dcterms:source "https://schemas.opengis.net/sweCommon/3.0/json/DataArray.json" ;
  rdfs:label "AbstractArray" ;
  rdfs:subClassOf swe:AbstractDataComponent ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:AbstractDataComponent ;
      owl:onProperty swe:elementType ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:AbstractEncoding ;
      owl:onProperty swe:encoding ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:ElementCount ;
      owl:onProperty swe:elementCount ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:EncodedValues ;
      owl:onProperty swe:values ;
    ] ;
  skos:definition " " ;
.
swe:AbstractDataComponent
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#_18f074eb-b7d6-ffcb-337d-3dd5b294c54e> ;
  rdfs:label "AbstractDataComponent" ;
  rdfs:subClassOf swe:AbstractSWEIdentifiable ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:ScopedName ;
      owl:onProperty swe:definition ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:definition ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:optional ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:updatable ;
    ] ;
  skos:definition "Abstract base class for all data components" ;
.
swe:AbstractEncoding
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#json_values_block> ;
  rdfs:label "AbstracEncoding" ;
  rdfs:subClassOf swe:AbstractSWE ;
  skos:definition "Inline values for “DataArray”, “Matrix” and “DataStream” components shall always be encoded using the JSON encoding rules when provided within a JSON document. No other method is allowed within a JSON document compliant with this standard. Inline block component values shall always be wrapped using a JSON Array." ;
.
swe:AbstractSWE
  a owl:Class ;
  dcterms:source "https://schemas.opengis.net/sweCommon/3.0/json/basicTypes.json" ;
  rdfs:label "AbstractSWE" ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:id ;
    ] ;
  skos:definition " " ;
.
swe:AbstractSWEIdentifiable
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#_18f074eb-b7d6-ffcb-337d-3dd5b294c54e> ;
  rdfs:label "AbstractSWEIdentifiable" ;
  rdfs:subClassOf swe:AbstractSWE ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:description ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:label ;
    ] ;
  skos:definition "Base substitution groups for all SWE Common objects with identification metadata" ;
.
swe:AbstractSimpleComponent
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#_18f074eb-b7d6-ffcb-337d-3dd5b294c54e> ;
  rdfs:label "AbstractSimpleComponent" ;
  rdfs:subClassOf swe:AbstractDataComponent ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:NilValues ;
      owl:onProperty swe:nilValues ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom xsd:string ;
      owl:onProperty swe:axisID ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:axisID ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:constraint ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:nilValues ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:referenceFrame ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:referenceFrame ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:value ;
    ] ;
.
swe:AllowedGeometries
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#uml_geometry_class> ;
  rdfs:label "AllowedGeometries" ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:minCardinality "0"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:geomType ;
    ] ;
.
swe:AllowedTimes
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#json_allowedtimes_obj> ;
  rdfs:label "AllowedTimes" ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:TimePair ;
      owl:onProperty swe:interval ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom xsd:dateTime ;
      owl:onProperty swe:value ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom xsd:positiveInteger ;
      owl:onProperty swe:significantFigures ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:significantFigures ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:minCardinality "0"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:interval ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:minCardinality "0"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:value ;
    ] ;
  skos:definition "The “AllowedTimes” object is the JSON schema implementation of the “AllowedTimes” UML class defined in Clause 8.2.19. The schema for this class is provided in basicTypes.json (see #definitions/AllowedTimes)." ;
.
swe:AllowedTokens
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#json_allowedtokens_obj> ;
  rdfs:label "AllowedTokens" ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom xsd:string ;
      owl:onProperty swe:pattern ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom xsd:string ;
      owl:onProperty swe:value ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:pattern ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:minCardinality "0"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:value ;
    ] ;
  skos:definition "The “AllowedTokens” object is the JSON schema implementation of the “AllowedTokens” UML class defined in Clause 8.2.17. The schema for this class is provided in basicTypes.json (see #definitions/AllowedTokens)." ;
.
swe:AllowedValues
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#json_allowedvalues_obj> ;
  rdfs:label "AllowedValues" ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:Real ;
      owl:onProperty swe:value ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:RealPair ;
      owl:onProperty swe:interval ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom xsd:integer ;
      owl:onProperty swe:significantFigures ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:significantFigures ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:minCardinality "0"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:interval ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:minCardinality "0"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:value ;
    ] ;
  skos:definition "The “AllowedValues” object is the JSON schema implementation of the “AllowedValues” UML class defined in Clause 8.2.18. The schema for this class is provided in basicTypes.json (see #definitions/AllowedValues)." ;
.
swe:AnyNumerical
  a owl:Class ;
  dcterms:source "https://docs.ogc.org/is/24-014/24-014.html#_b34a59af-d7b7-40a4-9e27-10c1eeb08bb1" ;
  rdfs:label "AnyNumerical" ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:Count ;
      owl:onProperty swe:byCount ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:Quantity ;
      owl:onProperty swe:byQuantity ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:Time ;
      owl:onProperty swe:byTime ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:bySomething ;
    ] ;
  skos:definition "Instances of this class should take one of byCount, byQuantity, byTime, which are sub-properties of bySomething" ;
.
swe:AnyRange
  a owl:Class ;
  dcterms:source "https://docs.ogc.org/is/24-014/24-014.html#_b34a59af-d7b7-40a4-9e27-10c1eeb08bb1" ;
  rdfs:label "AnyRange" ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:CategoryRange ;
      owl:onProperty swe:byCategoryRange ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:CountRange ;
      owl:onProperty swe:byCountRange ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:QuantityRange ;
      owl:onProperty swe:byQuantityRange ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:TimeRange ;
      owl:onProperty swe:byTimeRange ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:bySomething ;
    ] ;
  skos:definition "Instances of this class should take one of byCountRange, byQuantityRange, byTimeRange, byCategoryRange, which are sub-properties of bySomething" ;
.
swe:AnyScalar
  a owl:Class ;
  dcterms:source "https://docs.ogc.org/is/24-014/24-014.html#_b34a59af-d7b7-40a4-9e27-10c1eeb08bb1" ;
  rdfs:label "AnyScalar" ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:bySomething ;
    ] ;
  skos:definition "Instances of this class should take one of byBoolean, byCount, byQuantity, byTime, byCategory, byText, which are sub-properties of bySomething" ;
.
swe:AssociationAttributeGroup
  a owl:Class ;
  dcterms:source "https://schemas.opengis.net/sweCommon/3.0/json/basicTypes.json" ;
  rdfs:label "AssociationAttributeGroup" ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:href ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:arcrole ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:role ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:title ;
    ] ;
  skos:definition "Association attributes" ;
.
swe:BinaryEncoding
  a owl:Class ;
  dcterms:source "https://schemas.opengis.net/sweCommon/3.0/json/encodings.json" ;
  rdfs:label "BinaryEncoding" ;
  rdfs:subClassOf swe:AbstractEncoding ;
  skos:definition "Parameters of the binary encoding method" ;
.
swe:Boolean
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#json_boolean_obj> ;
  rdfs:label "Boolean" ;
  rdfs:subClassOf swe:AbstractSimpleComponent ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom xsd:boolean ;
      owl:onProperty swe:value ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:value ;
    ] ;
  skos:definition "The “Boolean” object is the JSON schema implementation of the “Boolean” UML class defined in Clause 8.2.4. The schema for this class is provided in Boolean.json." ;
.
swe:Category
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#json_category_obj> ;
  rdfs:label "Category" ;
  rdfs:subClassOf swe:AbstractSimpleComponent ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:AllowedTokens ;
      owl:onProperty swe:constraint ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom xsd:string ;
      owl:onProperty swe:value ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:codeSpace ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:constraint ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:nilValues ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:value ;
    ] ;
  skos:definition "The “Category” object is the JSON schema implementation of the “Category” UML class defined in Clause 8.2.6. The schema for this class is provided in Category.json." ;
.
swe:CategoryRange
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#json_categoryrange_obj> ;
  rdfs:label "CategoryRange" ;
  rdfs:subClassOf swe:AbstractSimpleComponent ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:AllowedTokens ;
      owl:onProperty swe:constraint ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:TokenPair ;
      owl:onProperty swe:valueObject ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:codeSpace ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:constraint ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:valueObject ;
    ] ;
  skos:definition "The “CategoryRange” object is the JSON schema implementation of the “CategoryRange” UML class defined in Clause 8.2.11. The schema for this class is provided in CategoryRange.json." ;
.
swe:Count
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#json_count_obj> ;
  rdfs:label "Count" ;
  rdfs:subClassOf swe:AbstractSimpleComponent ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:AllowedValues ;
      owl:onProperty swe:constraint ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom xsd:integer ;
      owl:onProperty swe:value ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:constraint ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:value ;
    ] ;
  skos:definition "The “Count” object is the JSON schema implementation of the “Count” UML class defined in Clause 8.2.7. The schema for this class is provided in Count.json." ;
.
swe:CountRange
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#json_countrange_obj> ;
  rdfs:label "CountRange" ;
  rdfs:subClassOf swe:AbstractSimpleComponent ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:AllowedValues ;
      owl:onProperty swe:constraint ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:IntegerPair ;
      owl:onProperty swe:valueObject ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:constraint ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:valueObject ;
    ] ;
  skos:definition "The “CountRange” object is the JSON schema implementation of the “CountRange” UML class defined in Clause 8.2.12. The schema for this class is provided in CountRange.json." ;
.
swe:DataArray
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#json_dataarray_obj> ;
  rdfs:label "DataArray" ;
  rdfs:subClassOf swe:AbstractArray ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:elementType ;
    ] ;
  skos:definition "The “DataArray” element is the JSON schema implementation of the “DataArray” UML class defined in Clause 8.5.1. The schema for this class is provided in DataArray.json." ;
.
swe:DataChoice
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#uml_datachoice_class> ;
  rdfs:label "DataChoice" ;
  rdfs:subClassOf swe:AbstractDataComponent ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:AbstractDataComponent ;
      owl:onProperty swe:item ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:Category ;
      owl:onProperty swe:choiceValue ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:choiceValue ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:minCardinality "2"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:item ;
    ] ;
  skos:definition "The “DataChoice” class (also called Disjoint Union) is modeled on the definition of ‘Choice’ from ISO 11404. It is a composite component that allows for a choice of child components. By opposition to records that carry all their fields simultaneously, only one item at a time can be present in the data when wrapped in a “DataChoice”." ;
.
swe:DataRecord
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#json_record_components> ;
  rdfs:label "DataRecord" ;
  rdfs:subClassOf swe:AbstractDataComponent ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:AbstractDataComponent ;
      owl:onProperty swe:field ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:field ;
    ] ;
  skos:definition "The “DataRecord” object is the JSON schema implementation of the “DataRecord” UML class defined in Clause 8.3.1. The schema for this class is provided in DataRecord.json." ;
.
swe:DataStream
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#json_datastream_obj> ;
  rdfs:label "DataStream" ;
  rdfs:subClassOf swe:AbstractSWEIdentifiable ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:AbstractDataComponent ;
      owl:onProperty swe:elementType ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:AbstractEncoding ;
      owl:onProperty swe:encoding ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:EncodedValues ;
      owl:onProperty swe:values ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:elementType ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
