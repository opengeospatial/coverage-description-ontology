.
swe:Vector
  a owl:Class ;
  dcterms:source <https://docs.ogc.org/is/24-014/24-014.html#uml_vector_class> ;
  rdfs:label "Vector" ;
  rdfs:subClassOf swe:AbstractDataComponent ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom swe:AnyNumerical ;
      owl:onProperty swe:coordinate ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:referenceFrame ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:localFrame ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty swe:coordinate ;
    ] ;
  skos:definition """The “Vector” class is used to express multi-dimensional quantities with respect to a well defined referenced frame (usually a spatial or spatio-temporal reference frame). This is done by projecting the quantity on one or several axes that define the reference frame and assigning a value to each of the axis projections.

The “Vector” class is a special case of a record that takes a collection of coordinates that are restricted to a numerical representation. """ ;
.
